{% extends 'base.html.twig' %}

{% block title %}Articles{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Tous les articles</h1>
        {% if is_granted('ROLE_USER') %}
            <a class="btn btn-primary" href="{{ path('post_new') }}">Nouvel article</a>
        {% endif %}
    </div>
    <div class="list-group">
        {% for post in posts %}
            <a class="list-group-item list-group-item-action" href="{{ path('post_show', {id: post.id}) }}">
                <div class="d-flex align-items-center gap-2">
                    <img src="{{ post.author.avatarFilename ? asset('uploads/avatars/' ~ post.author.avatarFilename) : 'https://ui-avatars.com/api/?name=' ~ (post.author.email|url_encode) ~ '&size=64' }}" alt="Avatar" class="rounded-circle" width="28" height="28">
                    <div>
                        <div class="fw-bold">{{ post.title }}</div>
                        <small class="text-muted">par {{ post.author.email }} — {{ post.createdAt|date('d/m/Y H:i') }}</small>
                    </div>
                </div>
            </a>
        {% else %}
            <div class="text-muted">Aucun article.</div>
        {% endfor %}
    </div>
</div>
{% endblock %}


