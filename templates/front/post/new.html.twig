{% extends 'base.html.twig' %}

{% block title %}Nouvel article{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <div class="bg-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-plus fa-2x text-white"></i>
                        </div>
                        <h1 class="h3 fw-bold">Créer un nouvel article</h1>
                        <p class="text-muted">Partagez vos idées avec la communauté</p>
                    </div>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        <div class="mb-4">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title) }}
                            {{ form_errors(form.title) }}
                        </div>
                        
                        <div class="mb-4">
                            {{ form_label(form.imageFile) }}
                            <div class="input-group">
                                {{ form_widget(form.imageFile) }}
                                <span class="input-group-text bg-light border-start-0">
                                    <i class="fas fa-image text-muted"></i>
                                </span>
                            </div>
                            {{ form_errors(form.imageFile) }}
                            <small class="text-muted">Ajoutez une image d'illustration pour rendre votre article plus attractif</small>
                        </div>
                        
                        <div class="mb-4">
                            {{ form_label(form.content) }}
                            {{ form_widget(form.content) }}
                            {{ form_errors(form.content) }}
                        </div>
                        
                        <div class="mb-4">
                            {{ form_label(form.category) }}
                            {{ form_widget(form.category) }}
                            {{ form_errors(form.category) }}
                        </div>
                        
                        <div class="mb-4">
                            {{ form_label(form.tags) }}
                            {{ form_widget(form.tags) }}
                            {{ form_errors(form.tags) }}
                            <div class="form-text">{{ form_help(form.tags) }}</div>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <button class="btn btn-success btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Publier l'article
                            </button>
                            <a href="{{ path('post_index') }}" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="fas fa-times me-2"></i>Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}


