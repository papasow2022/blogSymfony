{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid py-4 admin-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4 page-header section">
        <h1 class="h3 mb-0 card-title-strong">
            <i class="fas fa-users me-2"></i>Gestion des utilisateurs
            <div class="subtitle">Administration des comptes</div>
        </h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour au tableau de bord
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card section">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h5 class="mb-0 card-title-strong">Liste des utilisateurs</h5>
            <span class="badge badge-soft">{{ users|length }}</span>
        </div>
        <div class="card-body">
            {% if users is empty %}
                <p class="text-muted">Aucun utilisateur trouvé.</p>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Utilisateur</th>
                                <th>Rôles</th>
                                <th>Statut</th>
                                <th>Articles</th>
                                <th>Commentaires</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                                <tr>
                                    <td>{{ user.id }}</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="{{ user.avatarFilename ? asset('uploads/avatars/' ~ user.avatarFilename) : 'https://ui-avatars.com/api/?name=' ~ (user.email|url_encode) ~ '&size=32' }}" 
                                                 alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                                            <div>
                                                <div class="fw-semibold">{{ user.email }}</div>
                                                <div class="small text-muted">ID: {{ user.id }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% for role in user.roles %}
                                            {% if role == 'ROLE_ADMIN' %}
                                                <span class="badge badge-soft-danger">{{ role }}</span>
                                            {% else %}
                                                <span class="badge badge-soft">{{ role }}</span>
                                            {% endif %}
                                        {% endfor %}
                                    </td>
                                    <td>
                                        {% if user.isBlocked %}
                                            <span class="badge badge-soft-danger">Bloqué</span>
                                        {% else %}
                                            <span class="badge badge-soft-success">Actif</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge badge-soft">{{ user.posts|length }}</span>
                                    </td>
                                    <td>
                                        <span class="badge badge-soft">{{ user.comments|length }}</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            {% if user.isBlocked %}
                                                <form method="post" action="{{ path('admin_user_unblock', {id: user.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('unblock_user_' ~ user.id) }}">
                                                    <button type="submit" class="btn btn-success" title="Débloquer" onclick="return confirm('Débloquer cet utilisateur ?')">
                                                        <i class="fas fa-unlock"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="post" action="{{ path('admin_user_block', {id: user.id}) }}" style="display: inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('block_user_' ~ user.id) }}">
                                                    <button type="submit" class="btn btn-warning" title="Bloquer" onclick="return confirm('Bloquer cet utilisateur ?')">
                                                        <i class="fas fa-ban"></i>
                                                    </button>
                                                </form>
                                            {% endif %}
                                            
                                            <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                                <button type="submit" class="btn btn-danger" title="Supprimer" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ? Cette action est irréversible.')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %} 