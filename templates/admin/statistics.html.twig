{% extends 'base.html.twig' %}

{% block title %}Statistiques{% endblock %}

{% block body %}
<div class="container-fluid py-4 admin-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4 page-header section">
        <h1 class="h3 mb-0 card-title-strong">
            <i class="fas fa-chart-bar me-2"></i>Statistiques
            <div class="subtitle">Performance des contenus</div>
        </h1>
        <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Retour au tableau de bord
        </a>
    </div>

    <div class="row g-4 section">
        <!-- Articles les plus populaires -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0 card-title-strong">
                        <i class="fas fa-eye me-2"></i>Articles les plus vus
                    </h5>
                </div>
                <div class="card-body">
                    {% if popular_posts is empty %}
                        <p class="text-muted">Aucun article pour le moment.</p>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for post in popular_posts %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 card-title-strong">
                                            <a href="{{ path('post_show', {id: post.id}) }}" class="text-decoration-none">
                                                {{ post.title }}
                                            </a>
                                        </h6>
                                        <small class="text-muted">par {{ post.author.email }}</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge badge-soft">{{ post.viewsCount }} vues</span>
                                        <br>
                                        <small class="text-muted">{{ post.likesCount }} likes</small>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Articles les plus likés -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0 card-title-strong">
                        <i class="fas fa-heart me-2"></i>Articles les plus likés
                    </h5>
                </div>
                <div class="card-body">
                    {% if most_liked_posts is empty %}
                        <p class="text-muted">Aucun article pour le moment.</p>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for post in most_liked_posts %}
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 card-title-strong">
                                            <a href="{{ path('post_show', {id: post.id}) }}" class="text-decoration-none">
                                                {{ post.title }}
                                            </a>
                                        </h6>
                                        <small class="text-muted">par {{ post.author.email }}</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge badge-soft-danger">{{ post.likesCount }} likes</span>
                                        <br>
                                        <small class="text-muted">{{ post.viewsCount }} vues</small>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Utilisateurs actifs -->
        <div class="col-md-12 section">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0 card-title-strong">
                        <i class="fas fa-users me-2"></i>Utilisateurs actifs
                    </h5>
                </div>
                <div class="card-body">
                    {% if active_users is empty %}
                        <p class="text-muted">Aucun utilisateur pour le moment.</p>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead>
                                    <tr>
                                        <th>Utilisateur</th>
                                        <th>Articles</th>
                                        <th>Commentaires</th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in active_users %}
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="{{ user.avatarFilename ? asset('uploads/avatars/' ~ user.avatarFilename) : 'https://ui-avatars.com/api/?name=' ~ (user.email|url_encode) ~ '&size=32' }}" 
                                                         alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                                                    <div>
                                                        <strong>{{ user.email }}</strong>
                                                        {% if user.isAdmin %}
                                                            <span class="badge badge-soft-danger ms-1">Admin</span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge badge-soft">{{ user.posts|length }}</span>
                                            </td>
                                            <td>
                                                <span class="badge badge-soft">{{ user.comments|length }}</span>
                                            </td>
                                            <td>
                                                {% if user.isBlocked %}
                                                    <span class="badge badge-soft-danger">Bloqué</span>
                                                {% else %}
                                                    <span class="badge badge-soft-success">Actif</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('admin_users') }}" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 